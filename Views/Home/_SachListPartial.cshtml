@model IEnumerable<TranVanKiet_231230818.Models.Sach>

<div class="section-head">
    <h3>@ViewBag.TieuDe</h3>
    <a asp-controller="Sach" asp-action="Create">+ Thêm sách mới &rsaquo;</a>
</div>

<div class="grid">
    @foreach (var s in Model)
    {
        <div class="book-card">
            <a href="#"><img src="~/images/@(string.IsNullOrEmpty(s.Anh) ? "Img_1.jpg" : s.Anh)" alt="@s.TenSach" /></a>
            <h2>@s.TenSach</h2>
            <div class="book-foot">
                <span class="price">@(s.Gia.HasValue ? s.Gia.Value.ToString("0") : "Liên hệ")</span>
                <button type="button" class="btn-buy">Thêm vào giỏ</button>
            </div>
        </div>
    }
</div>